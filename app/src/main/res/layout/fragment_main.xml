<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainFragment">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bViewTransaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Transactions"
        app:layout_constraintBottom_toTopOf="@+id/bViewBalance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bSendMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="send money"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bViewBalance" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bViewBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Balance"
        app:layout_constraintBottom_toTopOf="@+id/bSendMoney"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bViewTransaction" />

</androidx.constraintlayout.widget.ConstraintLayout>